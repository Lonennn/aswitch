supported_targets = "native"

import {
  "moonbitlang/async",
  "moonbitlang/core/env",
  "lonen44/aswitch/cmd/aswitch/command",
  "moonbitlang/x/sys",
}

pkgtype(kind: "executable")

options(
  targets: { "aswitch.mbt": [ "native" ] },
  "pre-build": [
    {
      "input": [ "../../../moon.mod" ],
      "output": "version.mbt",
      "command": "moon run scripts/generate_version_file.mbtx",
    },
  ],
)
